# Freebuff project metadata (local tooling state)
.freebuff/

# Dependencies
node_modules/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Build output
dist/
build/
.output/
.wrangler/

# Training artifacts (regenerate with train.py / render_curve.py)
runs/
runs_*/
*.pid

# Trial output: wifi radar captures and lab runs, written where --out points.
# Regenerate by re-running the trial; the captures are megabytes of jsonl.
out/

# mediatop digests (regenerate with `python -m mediatop.server --save`)
mediatop-*.md

# The bench map page (regenerate with `python bench_map.py`)
bench-map.html

# Screenshots taken while reviewing a change; not part of the repo
screenshots/

# ditherlab is its own repository (its own .git, its own CI). Never add it here:
# git would either embed it as a half-submodule or flatten it and lose its
# history, and a directory with a .git inside shows as untracked either way.
ditherlab/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
