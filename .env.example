# The Archil disk these files live on — see archil_store.py and archil_check.py.
# Copy this file to .env, which is gitignored, and fill it in. archil_store reads
# it on the way to a disk; a real environment variable wins over a value here.
#
# An API key, not a disk or mount token: `key-…` from
# https://console.archil.com/api-keys. Keys are scoped to one region, so a key
# made in aws-us-east-1 does not work in aws-us-west-2.
ARCHIL_API_KEY=

# Defaults to aws-us-east-1. Commands (`archil_store.run`) exist only in
# aws-us-east-1, aws-us-west-2 and aws-eu-west-1.
ARCHIL_REGION=aws-us-east-1

# `dsk-…`. The first `archil_check.py` creates a disk and prints the id to put
# here; after that the check and every write go to the same disk.
ARCHIL_DISK_ID=
